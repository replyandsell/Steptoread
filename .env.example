# Скопируй этот файл в .env и впиши свои значения.
# Файл .env НЕ попадёт в git (он в .gitignore).
# После правки .env перезапусти dev-сервер: Vite читает переменные только при старте.

# Supabase → Project Settings → API → Project URL
# Проект живёт в регионе Central EU (Frankfurt).
VITE_SUPABASE_URL=https://впиши-сюда.supabase.co

# Supabase → Project Settings → API → anon public (он же Publishable key).
# НЕ service_role и НЕ secret: тот ключ обходит всю защиту базы.
VITE_SUPABASE_ANON_KEY=впиши-сюда-свой-anon-key

# Базовый адрес серверных функций. Локально оставь как есть.
VITE_API_BASE_URL=/api
