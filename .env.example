# Скопируй этот файл в .env и впиши свои значения.
# Файл .env НЕ попадёт в git (он в .gitignore).

# Supabase — твой Project URL уже вписан
VITE_SUPABASE_URL=https://qgwczqvjuhksqupgapsf.supabase.co

# Supabase anon public key (НЕ service_role!) — скопируй из Supabase: Settings -> API
VITE_SUPABASE_ANON_KEY=впиши-сюда-свой-anon-key

# Базовый адрес serverless-функций. Локально оставь как есть.
VITE_API_BASE_URL=/api
